# Everest Air Conditioning Company - Client Feedback Assistant Environment Variables

# PRIVATE CLIENT ACCESS PROTECTION
# Master access token required to view the feedback workflow: /everest-feedback?access=TOKEN
# Can be a single secure string or comma-separated tokens for distinct clients/projects
EVEREST_FEEDBACK_ACCESS_TOKEN=EVEREST-CLIENT-2026-SECURE

# Optional secret for cryptographic session HMAC signatures (defaults to hash of access token if omitted)
SESSION_SECRET=everest-private-session-secret-change-in-production

# Google Business Review Link (direct Google review dialog link for Everest HVAC)
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/CT-Hpr-UN0vwEBM/review

